# Production Configuration for Stellar Bounty Treasury Backend
NODE_ENV=production
PORT=3001

# Authoritative Stellar Network Endpoints
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Security & CORS Whitelist
CORS_ORIGIN=https://bounty.stellar.org
API_RATE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000

# Persistent Database File Path
DATABASE_PATH=/data/bounties.db

# Blockchain Indexer Sync Configuration
POLL_INTERVAL_MS=3000
START_LEDGER_CURSOR=latest
